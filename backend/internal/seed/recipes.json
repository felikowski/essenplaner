    "rating": 4,
    "toTry": true,
    "notes": "Mit weniger Chili für die Kinder.",
    "totalMinutes": 30,
    "createdAt": "2026-09-20T12:00:00Z",
    "ingredients": [
      "600 g Hähnchenbrust",
      "1 Zwiebel",
      "2 Knoblauchzehen",
      "1 EL Currypulver",
      "400 ml Kokosmilch",
      "1 rote Paprika",
      "Salz und Pfeffer",
      "250 g Basmatireis"
    ],
    "instructions": [
      "Reis nach Packungsanweisung kochen.",
      "Hähnchen in Würfel schneiden, Zwiebel und Knoblauch fein hacken.",
      "Hähnchen in Öl rundherum anbraten, Zwiebel und Knoblauch zugeben.",
      "Currypulver kurz mitrösten, mit Kokosmilch ablöschen.",
      "Paprika in Streifen zugeben und 10 Minuten köcheln lassen, abschmecken."
    ]
  },
