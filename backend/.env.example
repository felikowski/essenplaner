# Vorlage für die lokale Entwicklung: nach backend/.env.local kopieren (nicht im Repository).
# Werte siehe docs/auth0-setup.md. Lokal läuft das Frontend über Vite auf Port 5173.
AUTH0_DOMAIN=dev-axmg5opc18ioigzp.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
PUBLIC_URL=http://localhost:5173
# Kommagetrennte Auth0-Nutzer-IDs (auth0|…), wegen des | in Anführungszeichen
ALLOWED_SUBJECTS='auth0|...'
