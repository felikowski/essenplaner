{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "essenplaner-backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && PORT=18090 go run ./cmd/server"],
      "port": 18090,
      "autoPort": false
    },
    {
      "name": "essenplaner-frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "BACKEND_URL=http://localhost:18090 npm run dev --prefix frontend -- --port \"${PORT:-5173}\" --strictPort"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
